{
  "name": "leetlens",
  "private": true,
  "type": "module",
  "description": "Build tooling for the LeetLens Chrome extension. The extension version lives in extension/manifest.json.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "release": "node build.mjs --release",
    "zip": "node build.mjs --release --zip",
    "test": "node --test 'test/*.test.mjs'"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
